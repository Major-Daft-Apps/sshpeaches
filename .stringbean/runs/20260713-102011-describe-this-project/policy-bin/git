#!/usr/bin/env bash
_stringbean_git_subcommand() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -C|-c|--git-dir|--work-tree|--namespace|--config-env)
        if [[ $# -lt 2 ]]; then
          return 0
        fi
        shift 2
        ;;
      --git-dir=*|--work-tree=*|--namespace=*|--config-env=*|-c*)
        shift
        ;;
      --exec-path)
        if [[ $# -ge 2 && ${2:-} != -* ]]; then
          shift 2
        else
          shift
        fi
        ;;
      --exec-path=*|--no-pager|--paginate|-p|--bare|--no-replace-objects|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks)
        shift
        ;;
      --)
        shift
        if [[ $# -gt 0 ]]; then
          printf '%s\n' "$1"
        fi
        return 0
        ;;
      -*)
        shift
        ;;
      *)
        printf '%s\n' "$1"
        return 0
        ;;
    esac
  done
}
subcommand="$(_stringbean_git_subcommand "$@")"
case "$subcommand" in
  checkout|clean|commit|merge|pull|push|rebase|reset|restore|switch)
    echo "stringbean policy: this git operation is denied for subagents: git ${subcommand}" >&2
    exit 126
    ;;
esac
exec '/usr/bin/git' "$@"
